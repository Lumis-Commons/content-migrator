							</onClick>
						</control:lum_button>
						<control:lum_button id="deleteMigration" text="STR_DELETE">
							<rowAction />
							<onClick type="processAction" processActionId="deleteMigration">
								<validators>
									<validator type="selectedOne" controlId="migrationList.tabulardata" />
								</validators>
								<addParameters>
									<parameter name="migrationId">
										<value type="firstSelected" controlId="migrationList.tabulardata" />
									</parameter>
								</addParameters>
							</onClick>
						</control:lum_button>
						<control:lum_button id="undoMigration" text="STR_UNDO">
							<rowAction />
							<onClick type="processAction" processActionId="undoMigration">
								<validators>
									<validator type="selectedOne" controlId="migrationList.tabulardata" />
								</validators>
								<addParameters>
									<parameter name="migrationId">
										<value type="firstSelected" controlId="migrationList.tabulardata" />
									</parameter>
								</addParameters>
							</onClick>
						</control:lum_button>
						<control:lum_button id="migrationErrorDetails" text="STR_ERROR_DETAILS">
							<rowAction />
							<onClick type="popupRunTimeInterface" keepParentActive="false">
								<interfaceId>migrationError</interfaceId>
								<pageId>LumisBlankPage</pageId>
								<validators>
									<validator type="selectedOne" controlId="migrationList.tabulardata" />
								</validators>
								<addParameters>
									<parameter name="migrationId">
										<value type="firstSelected" controlId="migrationList.tabulardata" />
									</parameter>
								</addParameters>
							</onClick>
						</control:lum_button>
						<control:lum_button id="mapWidget" text="STR_MAP_WIDGET">
							<rowAction />
							<onClick type="popupRunTimeInterface" keepParentActive="false">
								<interfaceId>widgetMapping</interfaceId>
								<pageId>LumisBlankPage</pageId>
								<validators>
									<validator type="selectedOne" controlId="migrationList.tabulardata" />
								</validators>
								<addParameters>
									<parameter name="migrationId">
										<value type="firstSelected" controlId="migrationList.tabulardata" />
									</parameter>
								</addParameters>
							</onClick>
						</control:lum_button>
					</control:lum_interfaceHeaderButtons>
					<control:lum_adminList id="migrationList" dataId="id" sourceId="migrationAdmin" />
					<control:lum_script id="migrationStatusPolling">
						<script><![CDATA[
						(function () {
							var endpoint = g_LumisRootPath + "lumis/api/rest/br/com/lumis/commons/contentmigrator/contentmigration/status";
							var labels = {
								pt: { STOPPED: "Parado", STOPPED_WITH_ERROR: "Parado com erro", RUNNING: "Em execução", FINISHED: "Finalizado" },
								en: { STOPPED: "Stopped", STOPPED_WITH_ERROR: "Stopped with error", RUNNING: "Running", FINISHED: "Finished" }
							};
							function refreshMigrationStatuses() {
								fetch(endpoint, { credentials: "same-origin", headers: { "Accept": "application/json" } })
									.then(function (response) { if (!response.ok) throw new Error("status request failed"); return response.json(); })
									.then(function (items) {
										items.forEach(function (item) {
											var selector = 'input[name="migrationList.tabulardata"][value="' + item.id + '"]';
											var row = document.querySelector(selector);
											if (!row) return;
											var itemRow = row.closest("li.lum-list-item");
											if (!itemRow) return;
											var status = itemRow.querySelector(".lum-field-id-statusLabel .lum-field-value");
											var total = itemRow.querySelector(".lum-field-id-totalCount .lum-field-value");
											var migrated = itemRow.querySelector(".lum-field-id-migratedCount .lum-field-value");
											if (status) {
												var language = (document.documentElement.lang || navigator.language || "en").toLowerCase();
												var languageLabels = language.indexOf("pt") === 0 ? labels.pt : labels.en;
												status.textContent = languageLabels[item.status] || item.status;
											}
											if (total) total.textContent = item.totalCount;
											if (migrated) migrated.textContent = item.migratedCount;
										});
									})
									.catch(function () { /* Keep the last rendered status if polling fails. */ });
							}
							window.setInterval(refreshMigrationStatuses, 60000);
						})();
						]]></script>
					</control:lum_script>
				</control:lum_form>
			</controls>
			<!-- Process actions -->
			<processActions>
