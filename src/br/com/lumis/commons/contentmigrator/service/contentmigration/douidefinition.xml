					<field id="serviceId" name="STR_SERVICEID" dataType="string" />
					<field id="originServiceInstanceId" name="STR_ORIGINSERVICEINSTANCEID" dataType="guid" />
					<field id="destServiceInstanceId" name="STR_DESTSERVICEINSTANCEID" dataType="guid" />
					<field id="updateMode" name="STR_UPDATEMODE" dataType="string" />
					<field id="operation" name="STR_OPERATION" dataType="string" />
					<field id="status" name="STR_STATUS" dataType="string" />
					<field id="stopRequested" name="STR_STOPREQUESTED" dataType="boolean" />
					<field id="totalCount" name="STR_TOTALCOUNT" dataType="integer" />
					<field id="migratedCount" name="STR_MIGRATEDCOUNT" dataType="integer" />
					<field id="heartbeat" name="STR_HEARTBEAT" dataType="dateTime" />
					<field id="createdDate" name="STR_CREATEDDATE" dataType="dateTime" />
					<field id="startDate" name="STR_STARTDATE" dataType="dateTime" />
					<field id="endDate" name="STR_ENDDATE" dataType="dateTime" />
					<field id="author" name="STR_AUTHOR" dataType="string" />
					<field id="errorType" name="STR_ERRORTYPE" dataType="string" />
					<field id="errorMessage" name="STR_ERRORMESSAGE" dataType="string" />
					<field id="errorStack" name="STR_ERRORSTACK" dataType="text" />
					<field id="blockingOriginItemId" name="STR_BLOCKINGORIGINITEMID" dataType="string" />
					<field id="blockingWidgetContentId" name="STR_BLOCKINGWIDGETCONTENTID" dataType="guid" />
				</fields>
			</source>
			<source id="itemMap" type="table">
				<table>lum_cmig_MigItemMap</table>
				<fields>
					<field id="id" name="STR_ID" dataType="guid" isPrimaryKey="true" display="false" />
					<field id="kind" name="STR_KIND" dataType="string" isPrimaryName="true" />
					<field id="serviceId" name="STR_SERVICEID" dataType="string" />
					<field id="sourceId" name="STR_SOURCEID" dataType="string" />
					<field id="locale" name="STR_LOCALE" dataType="string" />
					<field id="warnings" name="STR_WARNINGS" dataType="text" />
					<field id="destCreated" name="STR_DESTCREATED" dataType="boolean" />
					<field id="originServiceInstanceId" name="STR_ORIGINSERVICEINSTANCEID" dataType="guid" />
					<field id="originContentId" name="STR_ORIGINCONTENTID" dataType="guid" />
					<field id="originContentLocaleId" name="STR_ORIGINCONTENTLOCALEID" dataType="guid" />
					<field id="originItemId" name="STR_ORIGINITEMID" dataType="string" />
					<field id="originFileFingerprint" name="STR_ORIGINFILEFINGERPRINT" dataType="string" />
					<field id="destServiceInstanceId" name="STR_DESTSERVICEINSTANCEID" dataType="guid" />
					<field id="destContentId" name="STR_DESTCONTENTID" dataType="guid" />
