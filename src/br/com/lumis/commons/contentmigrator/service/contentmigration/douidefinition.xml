				</filters>
			</source>
			<source id="migrationForm">
				<fields>
					<field id="name" name="STR_NAME" dataType="string" externalData="true" required="true" />
					<field id="serviceId" name="STR_SERVICE" dataType="string" externalData="true" required="true" />
					<field id="originServiceInstanceId" name="STR_ORIGIN" dataType="guid" externalData="true" required="true" />
					<field id="destServiceInstanceId" name="STR_DESTINATION" dataType="guid" externalData="true" required="true" />
				</fields>
