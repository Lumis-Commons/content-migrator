		<interface id="addMigration">
			<!-- Data sources -->
			<sources>
				<source id="migrationForm">
					<fields inherit="all" />
				</source>
				<source id="contentServices" readData="always">
					<fields inherit="all" />
				</source>
				<source id="originInstances" readData="always">
					<fields inherit="all" />
					<orderBy>
						<field direction="ascending" id="serviceInstanceName" />
					</orderBy>
				</source>
				<source id="destinationInstances" readData="always">
					<fields inherit="all" />
					<orderBy>
						<field direction="ascending" id="serviceInstanceName" />
					</orderBy>
				</source>
			</sources>
			<!-- Controls -->
			<controls>
				<control:lum_form>
					<control:lum_propertyPage>
						<control:lum_autoLayoutFields>
							<field id="name">
								<label>
									<control:lum_label text="STR_NAME" showRequired="true" />
								</label>
								<value>
									<control:lum_inputText id="name" sourceId="migrationForm" dataId="name" maxLength="255">
										<control:lum_requiredValueValidator />
									</control:lum_inputText>
								</value>
							</field>
							<field id="serviceId">
								<label>
									<control:lum_label text="STR_SERVICE" showRequired="true" />
								</label>
								<value>
									<control:lum_dropDownList
											id="serviceId"
											sourceId="migrationForm"
											dataId="serviceId"
											optionsSourceId="contentServices"
											valueFieldId="serviceId"
											textFieldId="serviceName"
											fieldName="STR_SERVICE">
										<control:lum_requiredValueValidator validateOnlyIfVisible="true" />
										<setSourceParameter sourceId="originInstances" parameterName="serviceId" />
										<setSourceParameter sourceId="destinationInstances" parameterName="serviceId" />
										<onChange type="script">
											<script><![CDATA[document.getElementById("originServiceInstanceId").value = "";
											document.getElementById("destServiceInstanceId").value = "";]]></script>
										</onChange>
										<onChange type="renderAction" />
									</control:lum_dropDownList>
								</value>
							</field>
							<field id="originServiceInstanceId">
								<label>
									<control:lum_label text="STR_ORIGIN" showRequired="true" />
								</label>
								<value>
									<control:lum_dropDownList
											id="originServiceInstanceId"
											sourceId="migrationForm"
											dataId="originServiceInstanceId"
											optionsSourceId="originInstances"
											valueFieldId="serviceInstanceId"
											textFieldId="serviceInstanceName"
											fieldName="STR_ORIGIN">
										<control:lum_requiredValueValidator validateOnlyIfVisible="true" />
										<setSourceParameter sourceId="destinationInstances" parameterName="originServiceInstanceId" />
										<onChange type="script">
											<script><![CDATA[document.getElementById("destServiceInstanceId").value = "";]]></script>
										</onChange>
										<onChange type="renderAction" />
									</control:lum_dropDownList>
								</value>
							</field>
							<field id="destServiceInstanceId">
								<label>
									<control:lum_label text="STR_DESTINATION" showRequired="true" />
								</label>
								<value>
									<control:lum_dropDownList
											id="destServiceInstanceId"
											sourceId="migrationForm"
											dataId="destServiceInstanceId"
											optionsSourceId="destinationInstances"
											valueFieldId="serviceInstanceId"
											textFieldId="serviceInstanceName"
											fieldName="STR_DESTINATION">
