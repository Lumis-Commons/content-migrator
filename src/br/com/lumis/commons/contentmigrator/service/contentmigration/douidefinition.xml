			<source id="widgetMapping">
				<dataProviderClassName>br.com.lumis.commons.contentmigrator.service.contentmigration.dataprovider.WidgetMappingDataProvider</dataProviderClassName>
				<fields>
					<field id="migrationId" dataType="guid" isPrimaryKey="true" />
					<field id="title" name="STR_BLOCKED_CONTENT_TITLE" dataType="string" />
					<field id="introduction" name="STR_BLOCKED_CONTENT_INTRODUCTION" dataType="text" />
					<field id="blockingOriginItemId" dataType="string" display="false" />
					<field id="originWidgetContentId" dataType="guid" />
					<field id="originWidgetName" name="STR_ORIGIN_WIDGET" dataType="string" />
					<field id="destServiceInstanceId" dataType="guid" display="false" />
					<field id="destRepoInstanceId" dataType="guid" display="false" />
				</fields>
