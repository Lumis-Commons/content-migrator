				</processAction>
				<processAction id="startUpdate" className="br.com.lumis.commons.contentmigrator.service.contentmigration.processaction.MigrationProcessActionHandler">
					<response type="doui_standardEmbedded" />
				</processAction>
				<processAction id="stopMigration" className="br.com.lumis.commons.contentmigrator.service.contentmigration.processaction.MigrationProcessActionHandler">
					<response type="doui_standardEmbedded" />
				</processAction>
				<processAction id="deleteMigration" className="br.com.lumis.commons.contentmigrator.service.contentmigration.processaction.MigrationProcessActionHandler">
					<message type="confirm">STR_CONFIRM_DELETE_MIGRATION</message>
					<response type="doui_standardEmbedded" />
				</processAction>
				<processAction id="undoMigration" className="br.com.lumis.commons.contentmigrator.service.contentmigration.processaction.MigrationProcessActionHandler">
					<message type="confirm">STR_CONFIRM_UNDO_MIGRATION</message>
