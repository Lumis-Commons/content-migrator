				<fields>
					<field id="serviceInstanceId" name="STR_ID" dataType="guid" isPrimaryKey="true" />
					<field id="serviceId" name="STR_SERVICEID" dataType="string" />
					<field id="serviceInstanceName" name="STR_DESTINATION" dataType="string" isPrimaryName="true" />
				</fields>
