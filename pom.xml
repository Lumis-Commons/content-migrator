<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>br.com.lumis.commons</groupId>
  <artifactId>contentmigrator</artifactId>
  <version>1.0</version>
  <name>Content Migrator</name>
	<repositories>
 		 <repository>
      		<id>lumisportal</id>
      		<url>https://repo.lumis.com.br/repository/lumisportal/</url>
    	</repository>
	</repositories>
  	<dependencies>
	  	<dependency>
	  		<groupId>com.lumis</groupId>
	  		<artifactId>lumisportal</artifactId>
	  		<version>19.0.0.260630-enterprise</version>
	  		<scope>provided</scope>
	  	</dependency>
	  	<dependency>
	  		<groupId>junit</groupId>
	  		<artifactId>junit</artifactId>
	  		<version>4.13.2</version>
	  		<scope>test</scope>
	  	</dependency>
  	</dependencies>
  	<properties>
		<maven.compiler.source>21</maven.compiler.source>
		<maven.compiler.target>21</maven.compiler.target>
		<maven.compiler.release>21</maven.compiler.release>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<!-- surefire would boot a second portal JVM; tests run only through test/run-tests.sh -->
		<skipTests>true</skipTests>
	</properties>
	<build>
		<finalName>br.com.lumis.commons.contentmigrator</finalName>
		<directory>target</directory>
		<outputDirectory>${project.build.directory}/classes</outputDirectory>
		<resources>
			<resource>
				<directory>src</directory>
				<excludes>
					<exclude>**/*.java</exclude>
					<exclude>**/*.class</exclude>
					<exclude>**/.svn</exclude>
					<exclude>**/_svn</exclude>
					<exclude>**/.DS_Store</exclude>
				</excludes>
			</resource>
		</resources>
		<sourceDirectory>src</sourceDirectory>
		<!-- Tests run only through test/run-tests.sh, against the portal in portal_install -->
		<testSourceDirectory>test/java</testSourceDirectory>
		<testResources>
			<testResource>
				<directory>test/resources</directory>
			</testResource>
		</testResources>
		<defaultGoal>package</defaultGoal>
		<plugins>
			<plugin>
				<artifactId>maven-jar-plugin</artifactId>
				<version>3.4.2</version>
				<configuration>
					<archive>
						<addMavenDescriptor>false</addMavenDescriptor>
					</archive>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.12.1</version>
				<configuration>
					<source>${maven.compiler.source}</source>
					<target>${maven.compiler.target}</target>
				</configuration>
			</plugin>
			<plugin>
				<artifactId>maven-clean-plugin</artifactId>
				<version>3.3.2</version>
				<configuration>
					<filesets>
						<fileset>
							<directory>${project.build.outputDirectory}/META-INF/lib</directory>
							<includes>
								<include>*.jar</include>
							</includes>
							<followSymlinks>false</followSymlinks>
						</fileset>
					</filesets>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<version>3.8.1</version>
				<executions>
					<execution>
						<id>copy-dependencies</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>copy-dependencies</goal>
						</goals>
						<configuration>
							<!-- Excluding commons-logging to prevent class loader conflicts caused by multiple versions of org.apache.commons.logging.Log. The library is already available in the classpath and should not be duplicated. -->
							<excludeArtifactIds>commons-logging</excludeArtifactIds>
							<outputDirectory>${project.build.outputDirectory}/META-INF/lib</outputDirectory>
							<includeScope>runtime</includeScope>
							<overWriteReleases>false</overWriteReleases>
							<overWriteSnapshots>false</overWriteSnapshots>
							<overWriteIfNewer>true</overWriteIfNewer>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
	<profiles>
		<!-- Local development: the portal loads the open module directly from src. -->
		<profile>
			<id>local-development</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-compiler-plugin</artifactId>
						<configuration>
							<outputDirectory>${project.basedir}/src</outputDirectory>
							<useIncrementalCompilation>false</useIncrementalCompilation>
						</configuration>
						<executions>
							<!-- Maven's test classpath still uses target/classes. -->
							<execution>
								<id>local-test-classpath</id>
								<phase>process-test-resources</phase>
								<goals><goal>compile</goal></goals>
								<configuration>
									<outputDirectory>${project.build.outputDirectory}</outputDirectory>
								</configuration>
							</execution>
							<!-- The local output override applies only to production classes. -->
							<execution>
								<id>default-testCompile</id>
								<configuration>
									<outputDirectory>${project.build.testOutputDirectory}</outputDirectory>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-dependency-plugin</artifactId>
						<configuration><skip>true</skip></configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>